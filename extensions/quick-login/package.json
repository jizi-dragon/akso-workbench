{
  "name": "workbench-extension",
  "version": "0.3.13",
  "private": true,
  "description": "Workbench 浏览器扩展（执行面）：六平面隔离 + 账号轮盘 + 自动填表",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "playwright-core": "1.62.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
