{
  "manifest_version": 3,
  "key": "",
  "name": "QuickLogin · 多账号并行",
  "short_name": "QuickLogin",
  "version": "0.3.4",
  "description": "纯浏览器多账号并行：每账号独立标签页与存储命名空间，页签名自定义，凭证加密保存。",
  "minimum_chrome_version": "110",
  "commands": {
    "quick-wheel": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "打开账号选择轮盘（可在 chrome://extensions/shortcuts 自定义；桌面壳运行时 Alt+Q 优先呼出桌面轮盘）"
    }
  },
  "icons": {
    "16": "assets/Icon16.png",
    "48": "assets/Icon48.png",
    "128": "assets/Icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "QuickLogin · 多账号并行",
    "default_popup": "ui/popup/popup.html",
    "default_icon": {
      "16": "assets/Icon16.png",
      "48": "assets/Icon48.png",
      "128": "assets/Icon128.png"
    }
  },
  "permissions": ["tabs", "scripting", "cookies", "storage", "alarms", "downloads", "webRequest", "declarativeNetRequestWithHostAccess", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/shield-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/shield-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/title-hook.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/auto-login.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
