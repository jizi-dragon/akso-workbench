{
  // Akso Workbench 工作区配置（本项目提交入库，两个协作人共用同一套口径）
  //
  // 为什么需要这个文件：本机的 uv 与 Python 都是**非常规位置**，VS Code 自动发现会失败
  //   - uv 不在 PATH：它是以 pip 包形式装进项目 .venv 的（.venv\Scripts\uv.exe）
  //   - Python 也不在 PATH：.venv 由 conda 的 Python 3.14.6 创建（.venv\pyvenv.cfg 的 home 指向 conda）
  // 不显式指定解释器时，VS Code 会报「未找到 Python」并建议用 uv 装一个 Python
  // ——那是误判（本机已有可用解释器），按下面配置即可消除。
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",

  // venv 里没有 pytest 时不要静默改用全局 pytest（会绕开项目依赖）
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // 静态检查走项目自带的 uvx（不在 PATH，故写全路径）
  "ruff.importStrategy": "fromEnvironment",
  "ruff.interpreter": ["${workspaceFolder}\\.venv\\Scripts\\python.exe"],
  "ruff.path": ["${workspaceFolder}\\.venv\\Scripts\\uvx.exe"],

  // 避免 VS Code 的 Python 扩展反复提示创建环境
  "python.terminal.activateEnvironment": true,
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "[markdown]": { "files.trimTrailingWhitespace": false },
  "[powershell]": { "files.eol": "\r\n" }
}