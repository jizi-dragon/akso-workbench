{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbench",
  "mainBinaryName": "Workbench",
  "version": "0.4.2",
  "identifier": "com.workbench.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "resources": {
      "../dist/WorkbenchServer": "server"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5RUMwQ0Y5Q0RBRDFCQkQKUldTOUc2M04rUXpzT1NYY2t3WW9jeHIxTjRROS9GaytycjhPdkhUMlQ2eS9mNFFpUy81aXNUVE0K",
      "endpoints": [
        "https://updates.example.com/workbench/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
