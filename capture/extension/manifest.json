{
  "manifest_version": 3,
  "name": "Akso 翻译（capture）",
  "version": "1.0.0",
  "description": "capture 浏览器专用的最小翻译扩展：在输入框按 Ctrl+X 翻译并复制，不包含账号、计数、换源等功能。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["clipboardWrite"],
  "host_permissions": [
    "https://transmart.qq.com/*",
    "https://api.mymemory.translated.net/*",
    "https://lingva.ml/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Akso 翻译：输入框 Ctrl+X"
  }
}
