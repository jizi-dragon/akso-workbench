tyle="text;html=1;align=left;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="3298" width="4225" height="20" as="geometry"/></mxCell><mxCell id="note_3318" value="工作流里 behaviorType=46 的动作改的是关联对象，不画在本页；完整步骤见各工作流分页。" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="3318" width="4225" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="wf-1" name="【提醒】等待供应物料评估完成"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="【提醒】等待供应物料评估完成" style="text;html=1;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="meta" value="code：waiting_for_the_evaluation_of_supplied_materials_to_be_completed__c&#xa;workflowBasicId：3a1e0f13-6e88-ac45-cbc5-73630099108a&#xa;workflowConfigId：3a1e0f13-6ea7-e06b-d58b-d1d3bed00ed8&#xa;status：20  版本：1  isAllowTrigger：是&#xa;触发：等待评估完成 / 生成待办（进入动作）" style="text;html=1;align=left;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="940" height="72" as="geometry"/></mxCell><mxCell id="wf1_step_0" value="1. [开始] 开始&#xa;waiting_for_the_evaluation_of_supplied_materials_to_be_completed_Start__c" style="ellipse;whiteSpace=wrap;html=1;fillColor=#70ad47;strokeColor=#939393;align=center;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="144" width="520" height="76" as="geometry"/></mxCell><mxCell id="wf1_step_1" value="2. [任务] 任务：责任人&#xa;task__c&#xa;通知任务" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ed7d31;strokeColor=#939393;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="282" width="520" height="76" as="geometry"/></mxCell><mxCell id="wf1_step_2" value="3. [结束] 结束&#xa;waiting_for_the_evaluation_of_supplied_materials_to_be_completed_End__c" style="ellipse;whiteSpace=wrap;html=1;fillColor=#70ad47;strokeColor=#939393;align=center;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="520" height="76" as="geometry"/></mxCell><mxCell id="wf1_edge_0" value="下一步" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;fontSize=9;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wf1_step_0" target="wf1_step_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="wf1_edge_1" value="下一步" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;fontSize=9;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wf1_step_1" target="wf1_step_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="wf1_note_582" value="图形固定遵循便笺本：橙色矩形 = 任务/动作，绿色圆形 = 开始/结束，橙色菱形 = 判断，黑色箭头 = 流转（docs/analysis/便笺本.xml）。" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="80" y="582" width="860" height="22" as="geometry"/></mxCell><mxCell id="wf1_note_604" value="动作节点里的“本对象 → 状态”才是本对象生命周期变更；“关联对象”不是本对象的状态边。" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="80" y="604" width="860" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram>
