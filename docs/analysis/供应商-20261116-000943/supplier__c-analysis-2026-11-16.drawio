x="1" parent="1"><mxGeometry x="60" y="1654" width="2205" height="20" as="geometry"/></mxCell><mxCell id="note_1674" value="工作流里 behaviorType=46 的动作改的是关联对象，不画在本页；完整步骤见各工作流分页。" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1674" width="2205" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="wf-1" name="供应商信息审核流程"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1566"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="供应商信息审核流程" style="text;html=1;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="meta" value="code：supplier_information_review__c&#xa;workflowBasicId：3a1d6f19-129d-f0a0-f2c6-d82e607e981e&#xa;workflowConfigId：22d929c4-5ae7-25eb-a4ac-3a1d7ee1161b&#xa;status：20  版本：1  isAllowTrigger：否&#xa;触发：开启 / 提交（用户动作）" style="text;html=1;align=left;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="940" height="72" as="geometry"/></mxCell><mxCell id="wf1_step_0" value="1. [开始] 开始&#xa;supplier_information_review_Start__c" style="ellipse;whiteSpace=wrap;html=1;fillColor=#70ad47;strokeColor=#939393;align=center;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="144" width="520" height="76" as="geometry"/></mxCell><mxCell id="wf1_step_1" value="2. [动作] 修改状态：信息审核&#xa;change_information_review__c&#xa;修改生命周期状态：本对象 → 信息审核" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ed7d31;strokeColor=#939393;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="282" width="520" height="76" as="geometry"/></mxCell><mxCell id="wf1_step_2" value="3. [任务] 任务：信息审核&#xa;task_information_review__c&#xa;任务；需要审批；审批按钮：同意/拒绝" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ed7d31;strokeColor=#939393;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="520" height="76" as="geometry"/></mxCell><mxCell id="wf1_step_3" value="4. [判断] 判断：供应商信息审核&#xa;judgment_reviewer__c&#xa;规则 1 条；有否则分支" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f4b183;strokeColor=#939393;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="558" width="520" height="76" as="geometry"/></mxCell><mxCell id="wf1_step_4" value="5. [动作] 修改状态：开启&#xa;change_init_status__c&#xa;修改生命周期状态：本对象 → 开启" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ed7d31;strokeColor=#939393;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="696" width="520" height="76" as="geometry"/></mxCell><mxCell id="wf1_step_5" value="6. [步骤 40] 通知：供应商信息审核拒绝&#xa;notification_declined__c" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ed7d31;strokeColor=#939393;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="834" width="520" height="76" as="geometry"/></mxCell><mxCell id="wf1_step_6" value="7. [动作] 修改状态：启用&#xa;change_Effect__c&#xa;修改生命周期状态：本对象 → 启用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ed7d31;strokeColor=#939393;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="972" width="520" height="76" as="geometry"/></mxCell><mxCell id="wf1_step_7" value="8. [步骤 40] 通知：供应商信息审核通过&#xa;notification_agree__c" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ed7d31;strokeColor=#939393;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="1110" width="520" height="76" as="geometry"/></mxCell><mxCell id="wf1_step_8" value="9. [结束] 结束&#xa;supplier_information_review_End__c" style="ellipse;whiteSpace=wrap;html=1;fillColor=#70ad47;strokeColor=#939393;align=center;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="1248" width="520" height="76" as="geometry"/></mxCell><mxCell id="wf1_edge_0" value="下一步" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;fontSize=9;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wf1_step_0" target="wf1_step_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="wf1_edge_1" value="下一步" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;fontSize=9;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wf1_step_1" target="wf1_step_2"><