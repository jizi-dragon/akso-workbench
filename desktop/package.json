{
  "name": "workbench-desktop",
  "productName": "Workbench",
  "version": "0.3.12",
  "private": true,
  "description": "Workbench 桌面壳（Electron）：窗口/热键/托盘/更新器 + Python 服务 sidecar",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:publish": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.workbench.app",
    "productName": "Workbench",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "updater.js",
      "shell-state.js",
      "ports.js",
      "proxy.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/WorkbenchServer",
        "to": "server"
      },
      {
        "from": "../extensions/quick-login/dist",
        "to": "extension"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Workbench-${version}-setup.${ext}",
      "shortcutName": "Workbench"
    },
    "publish": {
      "provider": "github",
      "owner": "jizi-dragon",
      "repo": "akso-mogul"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
